const fs = require('fs').promises;
//Standard Synchronous Function Call
fucntion calculateTotal(price, taxrate){
  return price + (price*taxrate);
}

const total = calculateTotal(1000,0.18);
console.log(`Synchronous Result : ${total}`);

//Callback Function Call (passing a function as an argument)
fucntion processOrder(orderId, callback){
  console.log(`Processing order is #${orderId}...`);
  setTimeout(()=>{                      //sets an delay (asynchronous mode) 
     callback(`Order #${orderId} confirmed !`);
  }, 1000);                             // It adds an delay of 1 second
}

processOrder(101, (status_message)=>{
  console.log(`Callback Result: ${status_message}`);
});

